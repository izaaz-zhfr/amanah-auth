{
  "info": {
    "name": "Amanah Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "reset_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register",
      "item": [
        {
          "name": "Register (sukses)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Budi Santoso\",\n  \"email\": \"budi.santoso@gmail.com\",\n  \"phone\": \"+6281234567890\",\n  \"password\": \"Rahasia#2026\",\n  \"confirm_password\": \"Rahasia#2026\",\n  \"accept_terms\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "if(j.data&&j.data.access_token){pm.collectionVariables.set('access_token',j.data.access_token);pm.collectionVariables.set('refresh_token',j.data.refresh_token);}",
                  "pm.test('201',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (duplikat -> 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Budi Santoso\",\n  \"email\": \"budi.santoso@gmail.com\",\n  \"phone\": \"+6281234567890\",\n  \"password\": \"Rahasia#2026\",\n  \"confirm_password\": \"Rahasia#2026\",\n  \"accept_terms\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409',()=>pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Login Email",
      "item": [
        {
          "name": "Login (sukses)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"budi.santoso@gmail.com\",\n  \"password\": \"Rahasia#2026\",\n  \"remember_me\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "if(j.data&&j.data.access_token){pm.collectionVariables.set('access_token',j.data.access_token);pm.collectionVariables.set('refresh_token',j.data.refresh_token);}",
                  "pm.test('200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (password salah -> 401 + attempts_remaining)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"budi.santoso@gmail.com\",\n  \"password\": \"Salah#123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Login WhatsApp",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login/whatsapp/otp/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+6281234567890\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP (isi kode dari log server)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login/whatsapp/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+6281234567890\",\n  \"code\": \"123456\",\n  \"remember_me\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "if(j.data&&j.data.access_token){pm.collectionVariables.set('access_token',j.data.access_token);pm.collectionVariables.set('refresh_token',j.data.refresh_token);}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Lupa Password",
      "item": [
        {
          "name": "Forgot (email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/password/forgot",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"identifier\": \"budi.santoso@gmail.com\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP -> reset_token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/password/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"identifier\": \"budi.santoso@gmail.com\",\n  \"code\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();if(j.data&&j.data.reset_token){pm.collectionVariables.set('reset_token',j.data.reset_token);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/password/reset",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reset_token\": \"{{reset_token}}\",\n  \"new_password\": \"Baru#Pass2026\",\n  \"confirm_password\": \"Baru#Pass2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "if(j.data&&j.data.access_token){pm.collectionVariables.set('access_token',j.data.access_token);pm.collectionVariables.set('refresh_token',j.data.refresh_token);}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Session",
      "item": [
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/token/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "if(j.data&&j.data.access_token){pm.collectionVariables.set('access_token',j.data.access_token);pm.collectionVariables.set('refresh_token',j.data.refresh_token);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/users/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}