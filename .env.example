# Amanah Auth API - template konfigurasi
# Salin file ini jadi .env lalu isi nilainya (jangan commit/kumpulkan file .env)

APP_ENV=development
PORT=8080

# Pilihan: postgres | memory (memory = demo tanpa database)
STORE_DRIVER=postgres

# Ganti USER dan PASSWORD dengan akun PostgreSQL milikmu
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/amanah?sslmode=disable

# JWT_SECRET minimal 32 karakter, OTP_SECRET minimal 16 karakter (isi string acak)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
OTP_SECRET=ganti-dengan-string-acak-16+

# DEV ONLY: kode OTP dicetak di log. Wajib false di production
LOG_OTP=true